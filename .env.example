TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
DATABASE_URL=sqlite:///./kairos.db
MAX_ACTIVE_PROJECTS=3
# IANA time zone used to group metrics by week (Monday to Sunday)
TIMEZONE=America/Guayaquil
# Reminders: days without activity before a project is flagged (active / paused), how often and
# how many times the bot repeats a stalled reminder, and quiet hours in TIMEZONE (may cross midnight)
REMINDERS_ENABLED=true
STALE_DAYS_ACTIVE=7
STALE_DAYS_PAUSED=30
REMINDER_REPEAT_DAYS=7
REMINDER_MAX_REPEATS=3
REMINDER_QUIET_START_HOUR=21
REMINDER_QUIET_END_HOUR=8
OBSIDIAN_VAULT_PATH=
# API URL the browser calls. Next.js inlines it at BUILD time: in Docker it goes in as a build arg
# (docker-compose.yml), so after changing it run `docker compose up -d --build`.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Origins allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:3000"]

# Host folder mounted as the Obsidian vault in Docker (dev)
VAULT_HOST_PATH=./vault-dev
