TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
DATABASE_URL=sqlite:///./kairos.db
MAX_ACTIVE_PROJECTS=3
OBSIDIAN_VAULT_PATH=
# API URL the browser calls. Next.js inlines it at BUILD time: in Docker it goes in as a build arg
# (docker-compose.yml), so after changing it run `docker compose up -d --build`.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Origins allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:3000"]

# Host folder mounted as the Obsidian vault in Docker (dev)
VAULT_HOST_PATH=./vault-dev
