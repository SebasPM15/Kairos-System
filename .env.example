# Copia este archivo a .env y completa los valores. El .env nunca se commitea.
# Los valores de ejemplo son falsos u obvios: reemplaza los secretos por los tuyos.

# --- Bot de Telegram -------------------------------------------------------------------------
# Token que entrega @BotFather. Vacío = el bot queda desactivado (la API y el dashboard siguen).
TELEGRAM_BOT_TOKEN=
# ID numérico de Telegram del único usuario autorizado (p. ej. 123456789). Vacío = nadie autorizado.
TELEGRAM_ALLOWED_USER_ID=

# --- Backend ---------------------------------------------------------------------------------
# En Docker el compose la fija a sqlite:////data/kairos.db; este valor es para el desarrollo nativo.
DATABASE_URL=sqlite:///./kairos.db
# Máximo de proyectos activos a la vez; todo proyecto activo exige una próxima acción.
MAX_ACTIVE_PROJECTS=3
# Zona horaria IANA: agrupa las métricas por semana (lunes a domingo) y define las horas de silencio.
TIMEZONE=America/Guayaquil
# Carpeta del vault de Obsidian para el export. En Docker el compose la fija a /vault.
OBSIDIAN_VAULT_PATH=
# Orígenes que pueden llamar a la API (lista JSON).
CORS_ORIGINS=["http://localhost:3000"]

# --- Recordatorios (bot) ---------------------------------------------------------------------
REMINDERS_ENABLED=true
# Días sin actividad para marcar un proyecto activo / pausado como estancado.
STALE_DAYS_ACTIVE=7
STALE_DAYS_PAUSED=30
# Cada cuántos días se repite un aviso de estancado y cuántas veces como máximo.
REMINDER_REPEAT_DAYS=7
REMINDER_MAX_REPEATS=3
# Horas de silencio en TIMEZONE (0-23, pueden cruzar la medianoche; inicio y fin deben ser distintos).
# El resumen diario se envía fuera de ese rango, a la primera ocasión tras terminar el silencio.
REMINDER_QUIET_START_HOUR=21
REMINDER_QUIET_END_HOUR=8

# --- Docker Compose --------------------------------------------------------------------------
# URL de la API que usa el navegador. Next.js la incrusta al COMPILAR: tras cambiarla,
# `docker compose up -d --build`.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Carpeta del host que se monta como vault en /vault.
VAULT_HOST_PATH=./vault-dev
# SOLO SERVIDOR (homelab): nombre del proyecto de Compose; define los nombres de volumen y contenedores.
# En el PC déjala comentada (el volumen se llama kairos-system_kairos-data).
# COMPOSE_PROJECT_NAME=nova-brain

# SOLO SERVIDOR (poca RAM): tope en MB del heap de Node durante `docker compose build` del frontend
# (--max-old-space-size). Vac�o = sin tope, igual que antes.
# NODE_BUILD_MEMORY_MB=384

# --- Valores en el servidor (homelab) --------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:8000          (se accede por túnel SSH)
# CORS_ORIGINS=["http://localhost:3000"]
# TIMEZONE=America/Guayaquil
# VAULT_HOST_PATH=/srv/projects/nova-brain/vault
# COMPOSE_PROJECT_NAME=nova-brain
